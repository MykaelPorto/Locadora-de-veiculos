# Copie este arquivo para ".env" se quiser mudar o banco de dados.
# Sem o .env, a API usa o SQLite abaixo (arquivo locadora.db na raiz do projeto).
DATABASE_URL=sqlite:///./locadora.db

# Exemplo com PostgreSQL (precisa: pip install "psycopg[binary]"):
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/locadora
